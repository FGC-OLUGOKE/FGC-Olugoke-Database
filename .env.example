# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,::1,testserver,your-app.vercel.app
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app
CSRF_TRUSTED_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# Supabase Database Configuration
# IMPORTANT: Use the DIRECT database connection, NOT the pooler connection
# Get these from your Supabase project: Settings > Database > Connection String
# The direct connection uses format: db.[PROJECT-REF].supabase.co:5432
# Do NOT use: aws-0-eu-west-1.pooler.supabase.com:6543 (this is for serverless functions)

# Option 1: Use DATABASE_URL (recommended)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.uvtysyugvxxhdcsenvne.supabase.co:5432/postgres

# Option 2: Use individual credentials (alternative)
DB_NAME=postgres
DB_USER=postgres.uvtysyugvxxhdcsenvne
DB_PASSWORD=[YOUR-PASSWORD]
DB_HOST=db.uvtysyugvxxhdcsenvne.supabase.co
DB_PORT=5432

# To use local SQLite instead of Supabase, comment out DATABASE_URL and DB_* variables above

# Supabase Configuration
SUPABASE_URL=https://uvtysyugvxxhdcsenvne.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_BUCKET_NAME=your-bucket-name-here

# Password reset email configuration
FRONTEND_URL=https://your-app.vercel.app
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@localhost
# For Resend/SMTP in production, set EMAIL_BACKEND to django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=your-resend-api-key
# EMAIL_USE_TLS=True

# Vercel deployment
VERCEL=true
DJANGO_SETTINGS_MODULE=config.settings
PYTHON_VERSION=3.12
VITE_API_BASE_URL=/api
